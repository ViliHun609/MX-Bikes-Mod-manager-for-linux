<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MXBikesModManager.ViewModels"
        xmlns:views="using:MXBikesModManager.Views"
        xmlns:services="using:MXBikesModManager.Services"
        x:Class="MXBikesModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MX Bikes Mod Manager"
        Width="1420"
        Height="880"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
            <TextBlock Text="MX" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="MX Bikes Mod Manager" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="{Binding ModsRoot}" Classes="muted" FontSize="11" MaxWidth="640"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModsRoot}" />
            <TextBlock Text="Drag &amp; drop .zip, .pkz or .pnt files anywhere to install" Classes="muted" FontSize="10" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ghost" Command="{Binding OpenModsFolderCommand}" IsEnabled="{Binding HasModsFolder}"
                  ToolTip.Tip="Open the mods folder">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{x:Static services:AppIcons.FolderIcon}" Width="14" Height="14" Stretch="Uniform"
                    Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Mods folder" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding InstallCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{x:Static services:AppIcons.DownloadIcon}" Width="14" Height="14" Stretch="Uniform"
                    Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Install mod…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{x:Static services:AppIcons.RefreshIcon}" Width="14" Height="14" Stretch="Uniform"
                    Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Refresh" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="primary" Command="{Binding LaunchGameCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{x:Static services:AppIcons.PlayIcon}" Width="13" Height="13" Stretch="Uniform"
                    Fill="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Launch MX Bikes" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- Missing folder banner -->
    <Border Grid.Row="1" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="0,0,0,1"
            Padding="16,10" IsVisible="{Binding !HasModsFolder}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="The MX Bikes mods folder could not be found. Point the manager at your Proton prefix's My Documents/PiBoSo/MX Bikes/mods folder."
                   Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="primary" Content="Choose folder" Command="{Binding OpenSettingsCommand}" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <!-- Mod type tabs -->
    <TabControl Grid.Row="2" Margin="10,10,10,0"
                ItemsSource="{Binding Types}"
                SelectedItem="{Binding SelectedType}"
                Padding="0">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ModTypeViewModel">
          <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,2">
            <Path Data="{Binding IconGeometry}" Width="17" Height="17" Stretch="Uniform"
                  Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="{DynamicResource TabCountBg}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
              <TextBlock Text="{Binding TotalCount}" FontSize="10" Classes="muted" />
            </Border>
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ModTypeViewModel">
          <views:ModTypeView />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Status bar -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Background="{DynamicResource PanelBg}" Margin="0,8,0,0">
      <ProgressBar Grid.Row="0" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="16,8" VerticalAlignment="Center">
        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Margin="18,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Classes="ghost" Command="{Binding OpenDataFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Data="{x:Static services:AppIcons.FolderIcon}" Width="13" Height="13" Stretch="Uniform"
                    Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Data folder" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding OpenLogsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Data="{x:Static services:AppIcons.LogsIcon}" Width="13" Height="13" Stretch="Uniform"
                    Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Logs" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Command="{Binding OpenSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Data="{x:Static services:AppIcons.SettingsIcon}" Width="13" Height="13" Stretch="Uniform"
                    Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Drop target overlay -->
    <Border x:Name="DropOverlay"
            Grid.Row="0" Grid.RowSpan="4"
            IsVisible="False" IsHitTestVisible="False"
            Background="{DynamicResource OverlayScrim}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="3"
            CornerRadius="10"
            Margin="8">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="Drop to install" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text=".zip · .7z · .rar · .pkz · .pnt · folders"
                   Classes="muted" FontSize="13" HorizontalAlignment="Center" />
        <TextBlock Text="You'll confirm the type and target before anything is copied."
                   Classes="muted" FontSize="12" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
