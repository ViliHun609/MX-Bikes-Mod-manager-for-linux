<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:MXBikesModManager.Models"
        x:Class="MXBikesModManager.Views.InstallTargetWindow"
        Title="Install mod"
        Width="600"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <StackPanel Margin="22" Spacing="14">

    <TextBlock x:Name="FileText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="KindText" Classes="muted" FontSize="12" TextWrapping="Wrap" />

    <TextBlock Text="Where should this mod be installed?" FontWeight="SemiBold" Margin="0,4,0,0" />

    <ListBox x:Name="TypeList" Height="196" SelectionChanged="OnTypeChanged">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:ModTypeConfig">
          <Grid ColumnDefinitions="Auto,*" Margin="4,4">
            <Border Width="36" Height="36" CornerRadius="9"
                    Background="{DynamicResource ChipBg}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Path Data="{Binding IconGeometry}" Width="20" Height="20" Stretch="Uniform"
                    Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Folder}" Classes="muted" FontSize="11" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel x:Name="PaintPanel" Spacing="6" IsVisible="False">
      <TextBlock Text="Which bike is this paint for?" Classes="muted" FontSize="12" />
      <AutoCompleteBox x:Name="PaintBikeBox"
                       Watermark="Start typing a bike name…"
                       FilterMode="Contains"
                       MinimumPrefixLength="1" />
    </StackPanel>

    <StackPanel x:Name="SubfolderPanel" Spacing="6">
      <TextBlock Text="Subfolder" Classes="muted" FontSize="12" />
      <AutoCompleteBox x:Name="SubfolderBox"
                       Watermark="Leave empty for the type folder"
                       FilterMode="Contains"
                       MinimumPrefixLength="0" />
      <TextBlock Text="Pick boots, helmets, protections… or type a custom folder." Classes="muted" FontSize="11" />
    </StackPanel>

    <Border Background="{DynamicResource TargetBg}" BorderBrush="{DynamicResource TargetBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7">
      <TextBlock x:Name="TargetText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <TextBlock x:Name="WarningText" Foreground="{DynamicResource WarningText}" FontSize="12" TextWrapping="Wrap" IsVisible="False" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Classes="primary" Content="Install" Click="OnInstall" />
    </StackPanel>

  </StackPanel>
</Window>
